  "etabs": {
    "material_name": "C4000psi",
    "beam_material_name": "C4000psi",
    "column_material_name": "C4000psi",
    "slab_material_name": "C4000psi",
    "beam_rebar_long": "A615Gr60",
    "beam_rebar_tie": "A615Gr60",
    "column_rebar_long": "A615Gr60",
    "column_rebar_tie": "A615Gr60",
    "dead_pattern": "DEAD",
    "units": "us",
    "material_strength_system": "auto",
    "concrete_fc_psi": 4000,
    "rebar_fy_ksi": 60,
    "rebar_fu_ksi": 90,
    "beam_cover_in": 1.5,
    "column_cover_in": 1.5,
    "column_tie_spacing_in": 6,
    "column_main_bar_size": "#6",
    "column_tie_bar_size": "#4"
  }
}
