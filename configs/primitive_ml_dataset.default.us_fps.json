{
  "description": "US/FPS preset (etabs.units=us: kip, ft, F). Geometry aliases in ft/in convert to internal metres. Slab super-dead/live in ksf. analysis_inputs: pattern names, present_units (e.g. kip_ft_F), csi_table_output_options, asce716_load_combinations (template_combos + design_sets; optional custom_combos JSON linear-add combos; replace_existing_combos).",
  "with_analysis_responses": true,
  "export_all_available_tables": true,
  "analysis_inputs": {
    "super_dead_pattern": "SDL",
    "live_pattern": "LIVE",
    "super_dead_value": 0.02,
    "live_value": 0.05,
    "seismic_design_code": "asce7_16",
    "seismic_x_name": "QX",
    "seismic_y_name": "QY",
    "seismic_ss": 1.0,
    "seismic_s1": 0.4,
    "seismic_r": 8.0,
    "seismic_site_class": 3,
    "csi_product": "etabs",
    "apply_csi_table_output_options": true,
    "present_units": "kip_ft_F",
    "csi_table_output_options": {
      "multistep_static": 1,
      "nonlinear_static": 1,
      "modal_history": 1,
      "direct_history": 1,
      "load_combo_multiple": 1,
      "mode_shape_option": 1,
      "mode_shape_start": 1,
      "mode_shape_end": 12,
      "buckling_option": 1,
      "buckling_start": 1,
      "buckling_end": 6,
      "base_react_option": 1,
      "base_react_x": 0.0,
      "base_react_y": 0.0,
      "base_react_z": 0.0
    },
    "asce716_load_combinations": {
      "apply": true,
      "template_combos": true,
      "design_sets": ["concrete_frame", "steel_frame", "slab_gravity"],
      "include_wind": false,
      "include_seismic": true,
      "use_etabs_default_combos": false,
      "replace_existing_combos": false,
      "custom_combos": {
        "USER_GRAVITY_CHECK": [["DEAD", 1.0], ["LIVE", 1.0]]
      }
    }
  },
  "sampling": {
    "method": "lhs",
    "target_accepted": 200,
    "seed": 42,
    "max_draws": 20000
  },
  "discrete": {
    "nx": [2, 3, 4, 5],
    "ny": [2, 3, 4, 5],
    "n_stories": [2, 3, 4, 5, 6, 7, 8, 9, 10],
    "h_story_ft": [10.0, 11.0, 12.0]
  },
  "continuous": {
    "Sx_ft": { "min": 13.1234, "max": 29.5276 },
    "Sy_ft": { "min": 13.1234, "max": 29.5276 },
    "hb_in": { "min": 16.5354, "max": 37.4016 },
    "bw_over_hb": { "min": 0.4, "max": 0.8 },
    "bcx_in": { "min": 13.7795, "max": 25.5906 },
    "bcy_in": { "min": 15.748, "max": 33.4646 },
    "ts_in": { "min": 7.0866, "max": 12.5984 },
    "col_top_area_ratio": { "min": 0.35, "max": 1.0 },
    "col_ext_area_ratio": { "min": 0.55, "max": 1.0 }
  },
  "constraints": {
    "hb_over_Smax": [0.06, 0.14],
    "ts_over_Smax": [0.03, 0.08],
    "plan_aspect_ratio": [0.25, 1.0],
    "internal_bay_variance": [0.45, 1.0],
    "elevation_aspect_ratio": [0.15, 1.0],
    "beam_aspect_ratio": [0.35, 0.85],
    "column_aspect_ratio": [0.45, 1.0],
    "column_area_index": [0.25, 1.0],
    "ext_to_int_col_area_ratio": [0.45, 1.0],
    "beam_to_slab_vol_ratio": [0.12, 1.15],
    "col_vol_to_floor_vol": [0.06, 0.95],
    "Smax_ft": [11.4829, 36.0892],
    "h_story_ft": [10.0, 12.0],
    "hb_in": [11.0236, 41.3386],
    "bw_in": [7.0866, 29.5276],
    "bc_min_in": [11.811, 35.4331],
    "ts_in_abs": [4.7244, 14.9606],
    "column_vs_beam_factor": 0.62,
    "column_slenderness_max": 28.0,
    "beam_flat_max_ratio": 1.0,
    "column_side_ratio_max": 3.0,
    "beam_onto_column_max_ratio": 1.0,
    "beam_slab_bw_over_ts_min": 2.5,
    "scwb_stiffness_ratio_min": 0.5
